# ─────────────────────────────────────────────
# masterthesis-code — root .gitignore
# Covers: Rust, Node/Next.js, Python, Java/Gradle,
# Terraform, Kubernetes, Helm, secrets, OS & IDE.
# Per-app .gitignore files still apply in their subdirs.
# ─────────────────────────────────────────────


# ── OS & IDE ──
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ── AI & agent tools ──
.agents/
.claude/
.windsurf/
.claude-drops/

# ── Secrets / environment ──
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ── Logs ──
*.log
logs/

# ── Rust (ingestion-service) ──
target/
**/*.rs.bk

# ── Node.js / Next.js (frontend) ──
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python (analytics-service, simulation-engine) ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Java / Kotlin / Gradle (core-platform) ──
.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.properties

# ── Terraform ──
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Kubernetes / Helm ──
charts/*.tgz
**/charts/*.tgz
*.kubeconfig

# ── Archives / misc ──
*.zip
*.tar.gz
*.rar
*.lck

# Local dev stack runtime state (scripts/dev.sh)
.dev/
